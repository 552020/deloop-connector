{
  "name": "deloop-bridge",
  "version": "0.2.0",
  "description": "Connects your AI agent on your computer to Matrix and to Deloop.",
  "type": "module",
  "bin": {
    "deloop-bridge": "cli.mjs"
  },
  "engines": {
